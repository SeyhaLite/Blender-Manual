# Khmer (ខ្មែរ) translations for Sphinx's own UI messages and the furo theme
# templates used by the Khmer Blender Manual.
#
# Sphinx has no built-in `km` catalog, so without this file every piece of
# chrome around the translated content — admonition titles ("Note", "Warning"),
# the vendored `.. reference::` box title, prev/next labels, the search box,
# the theme toggle, permalinks — stays in English even though the pages are
# Khmer.
#
# Sphinx compiles this .po into locale/km/LC_MESSAGES/sphinx.mo automatically
# at build time (babel is a hard dependency, see requirements.txt).
#
# Only msgids that actually exist in Sphinx 9 / furo are listed here; an entry
# that no longer matches simply stays unused.
#
# Copyright: this catalog is a translation work, licensed CC-BY-SA 4.0
# International, same as the manual content it serves.
msgid ""
msgstr ""
"Project-Id-Version: Blender Manual (Khmer) 5.2\n"
"Report-Msgid-Bugs-To: https://github.com/SeyhaLite/Blender-Manual/issues\n"
"POT-Creation-Date: 2026-10-20 00:00+0000\n"
"PO-Revision-Date: 2026-10-20 00:00+0000\n"
"Last-Translator: Khmer Translation Contributors\n"
"Language: km\n"
"Language-Team: Khmer\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Generated-By: manual\n"

